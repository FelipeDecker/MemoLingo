@page "/learn"
@page "/section/{SectionId:int}"

<PageTitle>Aprender</PageTitle>

@if (activeUnit == null)
{
    <p class="loading"><em>Carregando trilha...</em></p>
}
else
{
    @* Banner fixo no topo da trilha: mostra sempre a unidade atualmente em foco na tela
       e é substituído pela próxima unidade assim que o usuário rola até ela (efeito Duolingo). *@
    <div class="unit-banner" style="background-color:@activeUnit.PrimaryColor; box-shadow:0 4px 0 @Darken(activeUnit.PrimaryColor)">
        <div class="unit-banner-info">
            <a class="unit-banner-back" href="/sections">
                <span class="unit-banner-back-icon" aria-hidden="true">←</span>
                <span class="unit-banner-subtitle">Seção @SectionNumber, Unidade @GetUnitNumber(activeUnit)</span>
            </a>
            <h2 class="unit-banner-title">@activeUnit.Name</h2>
            @if (!string.IsNullOrWhiteSpace(activeUnit.Description))
            {
                <p class="unit-banner-description">@activeUnit.Description</p>
            }
        </div>

        <button type="button" class="unit-banner-guide">
            <span class="unit-banner-guide-icon" aria-hidden="true">📘</span>
            <span>GUIA</span>
        </button>
    </div>

    <div class="path-container">
        @for (var unitIndex = 0; unitIndex < units.Count; unitIndex++)
        {
            var unit = units[unitIndex];

            @* Cada unidade é um bloco observado pelo IntersectionObserver: quando o topo do
               bloco (o separador) passa sob o banner fixo, o cabeçalho é atualizado. *@
            <section class="unit-block" data-unit-id="@unit.Id">
                @if (unitIndex > 0)
                {
                    <UnitSeparator Text="@GetSeparatorText(unit)" Color="@unit.PrimaryColor" />
                }

                <div class="path">
                    @{
                        var i = 0;
                    }
                    @foreach (var lesson in unit.Lessons.OrderBy(l => l.Order))
                    {
                        @* Onda senoidal: gera o deslocamento horizontal que desenha a trilha sinuosa. *@
                        double translateX = Math.Sin(i * Frequency) * Amplitude;
                        i++;

                        var nodeColor = GetLessonColor(unit, lesson);

                        <div class="path-row">
                            <button type="button"
                                    class="path-node @GetStatusClass(lesson.Status)"
                                    style="transform: translateX(@Px(translateX)); background-color:@nodeColor; box-shadow:0 5px 0 @Darken(nodeColor)"
                                    title="@lesson.Title"
                                    disabled="@IsLocked(lesson)"
                                    @onclick="() => OpenLesson(lesson)">
                                <span class="path-node-icon">@GetIcon(lesson)</span>
                            </button>
                        </div>
                    }
                </div>
            </section>
        }
    </div>
}
