@page "/"
@inject ILessonService LessonService
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Aprender</PageTitle>

@if (units == null)
{
    <p class="carregando"><em>Carregando trilha...</em></p>
}
else
{
    @* Cabeçalho fixo no topo da trilha: mostra sempre a unidade atualmente em foco na tela
       e é substituído pela próxima unidade assim que o usuário rola até ela (efeito Duolingo). *@
    <div class="unidade-fixa" style="background-color:@activeUnit.PrimaryColor">
        <div class="unidade-fixa-texto">
            <span class="unidade-nome">@activeUnit.Name</span>
            <strong class="unidade-descricao">@activeUnit.Description</strong>
        </div>
    </div>

    <div class="trilha-container">
        @foreach (var unit in units)
        {
            @* Marcador invisível usado apenas para detectar, via scroll, qual unidade está em foco. *@
            <div class="unidade-marcador" data-unidade-id="@unit.Id"></div>

            <div class="trilha">
                @{
                    var globalIndex = 0;
                }
                @foreach (var lesson in unit.Lessons.OrderBy(l => l.Order))
                {
                    var offset = GetOffset(globalIndex);
                    globalIndex++;

                    <div class="bolinha-linha" style="justify-content:@(offset >= 0 ? "flex-start" : "flex-end")">
                        <div class="bolinha @GetStatusClass(lesson.Status)"
                             style="background-color:@GetLessonColor(unit, lesson); margin-left:@(offset)px"
                             title="@lesson.Title">
                            <span class="bolinha-icone">@GetIcon(lesson)</span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private List<Unit> units;
    private Unit activeUnit;
    private DotNetObjectReference<Learn> jsReference;

    // Padrão de deslocamento horizontal (em px) que gera o efeito de "zigue-zague"
    // da trilha, imitando o layout de trilhas do Duolingo.
    private static readonly int[] OffsetPattern = { 0, 60, 90, 60, 0, -60, -90, -60 };

    protected override async Task OnInitializedAsync()
    {
        // Chamada ao serviço mock, que simula uma chamada real a uma API.
        units = await LessonService.GetUnitsAsync();
        activeUnit = units.FirstOrDefault();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && units is { Count: > 0 })
        {
            // Registra o observador de scroll em JS para saber qual unidade está visível
            // logo abaixo do cabeçalho fixo, e assim atualizar o título exibido.
            jsReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("trilhaScroll.iniciar", jsReference);
        }
    }

    /// <summary>
    /// Chamado via JS interop sempre que a unidade em foco na tela muda durante o scroll.
    /// </summary>
    [JSInvokable]
    public void UpdateActiveUnit(int unitId)
    {
        var unit = units?.FirstOrDefault(u => u.Id == unitId);
        if (unit != null && unit != activeUnit)
        {
            activeUnit = unit;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (jsReference != null)
        {
            try
            {
                await JS.InvokeVoidAsync("trilhaScroll.finalizar");
            }
            catch (JSDisconnectedException)
            {
                // A conexão já foi encerrada (ex.: navegação/fechamento da página); nada a fazer.
            }

            jsReference.Dispose();
        }
    }

    private static int GetOffset(int index) => OffsetPattern[index % OffsetPattern.Length];

    private static string GetStatusClass(LessonStatus status) => status switch
    {
        LessonStatus.Completed => "concluida",
        LessonStatus.Available => "disponivel",
        _ => "bloqueada"
    };

    private static string GetLessonColor(Unit unit, Lesson lesson) => lesson.Status switch
    {
        LessonStatus.Locked => "#e5e5e5",
        _ => unit.PrimaryColor
    };

    private static string GetIcon(Lesson lesson)
    {
        if (lesson.Status == LessonStatus.Locked)
        {
            return "🔒";
        }

        if (lesson.Status == LessonStatus.Completed)
        {
            return "✓";
        }

        return lesson.Type switch
        {
            LessonType.Story => "📖",
            LessonType.Chest => "🎁",
            LessonType.Exam => "🏆",
            _ => "⭐"
        };
    }
}
