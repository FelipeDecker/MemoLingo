@page "/pratica/nuances"

<PageTitle>Nuances</PageTitle>

<div class="nuance-container">
    @if (loading)
    {
        <p class="carregando"><em>Preparando suas frases...</em></p>
    }
    else if (queue.Count == 0)
    {
        <div class="resumo-sessao">
            <h2>Nada para praticar ainda</h2>
            <p>Ainda não há grupos de nuances cadastrados para o seu curso.</p>
            <button class="btn-principal" @onclick="GoBackToHub">Voltar para praticar</button>
        </div>
    }
    else if (sessionCompleted)
    {
        <div class="resumo-sessao">
            <h2>Sessão concluída! 🎯</h2>
            <p>Você escolheu a palavra certa em @sessionCorrectCount de @queue.Count frases.</p>

            <div class="resumo-metricas">
                <div class="resumo-metrica">
                    <span class="resumo-metrica-valor">@AccuracyPercentage%</span>
                    <span class="resumo-metrica-rotulo">Acertos</span>
                </div>
                <div class="resumo-metrica">
                    <span class="resumo-metrica-valor">@(queue.Count - sessionCorrectCount)</span>
                    <span class="resumo-metrica-rotulo">Para revisar</span>
                </div>
            </div>

            <div class="resumo-acoes">
                <button class="btn-secundario" @onclick="StartSessionAsync">Praticar de novo</button>
                <button class="btn-principal" @onclick="GoBackToHub">Concluir</button>
            </div>
        </div>
    }
    else
    {
        var current = queue[currentIndex];
        var parts = SplitSentence(current.SentenceContext);

        <div class="sessao-progresso">Frase @(currentIndex + 1) de @queue.Count</div>

        <div class="nuance-cabecalho">
            <span class="grupo-etiqueta">@current.GroupMeaning</span>
            <span class="grupo-nivel">@current.CefrLevel</span>
            @if (current.IsPriorityReview)
            {
                <span class="grupo-prioridade" title="Você errou uma palavra deste grupo recentemente">Revisão prioritária</span>
            }
        </div>

        <div class="nuance-card">
            <p class="nuance-instrucao">Complete com a palavra que melhor se encaixa no contexto:</p>

            <p class="nuance-frase" lang="en">
                @parts.Before<span class="lacuna @BlankCss">@BlankText</span>@parts.After
            </p>

            @if (showTranslation || result is not null)
            {
                <p class="nuance-traducao">@current.SentenceTranslation</p>
            }
            else
            {
                <button class="btn-link" @onclick="() => showTranslation = true">Mostrar tradução</button>
            }

            <div class="opcoes" role="group" aria-label="Palavras do grupo">
                @foreach (var option in current.Options)
                {
                    <button class="opcao @(selectedWordId == option.WordId ? "opcao-selecionada" : string.Empty)"
                            disabled="@(result is not null || submitting)"
                            @onclick="() => SelectOption(option)">
                        @option.Text
                    </button>
                }
            </div>

            @if (result is null)
            {
                <div class="resposta">
                    <input class="resposta-input"
                           type="text"
                           placeholder="Digite a palavra (ex.: handled)"
                           autocomplete="off"
                           autocapitalize="off"
                           spellcheck="false"
                           value="@answer"
                           disabled="@submitting"
                           @oninput="OnAnswerInput"
                           @onkeydown="OnAnswerKeyDown" />
                    <button class="btn-principal" disabled="@(!CanSubmit)" @onclick="SubmitAsync">Verificar</button>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <p class="mensagem-erro">@errorMessage</p>
                }
            }
        </div>

        @if (result is not null)
        {
            <div class="resultado @(result.IsCorrect ? "resultado-certo" : "resultado-errado")">
                <h3 class="resultado-titulo">
                    @(result.IsCorrect ? "Isso aí! 🎉" : "Não é bem essa...")
                </h3>

                @if (!result.IsCorrect)
                {
                    <p class="resultado-resposta">
                        Você respondeu <strong>@result.SubmittedAnswer</strong>; o correto é <strong>@result.CorrectAnswer</strong>.
                    </p>
                }

                <p class="resultado-frase" lang="en">@result.CompletedSentence</p>
                <p class="resultado-explicacao">@result.Explanation</p>
            </div>

            <section class="nuances">
                <h3 class="nuances-titulo">Entenda a nuance de cada palavra</h3>

                @foreach (var item in result.Nuances)
                {
                    <div class="nuance-item @NuanceItemCss(item)">
                        <div class="nuance-item-cabecalho">
                            <strong class="nuance-item-palavra" lang="en">@item.Text</strong>
                            <span class="nuance-item-traducao">@item.Translation</span>
                            @if (item.IsCorrectAnswer)
                            {
                                <span class="nuance-item-marca marca-certa">Resposta</span>
                            }
                            else if (item.IsSubmittedAnswer)
                            {
                                <span class="nuance-item-marca marca-errada">Sua escolha</span>
                            }
                        </div>
                        <p class="nuance-item-explicacao">@item.NuanceExplanation</p>
                    </div>
                }
            </section>

            @if (result.GroupProgress is not null)
            {
                <p class="grupo-proficiencia">
                    Domínio deste grupo: <strong>@result.GroupProgress.ProficiencyScore%</strong>
                    (@result.GroupProgress.CorrectCount acerto(s), @result.GroupProgress.WrongCount erro(s))
                </p>
            }

            <button class="btn-principal" @onclick="Next">Continuar</button>
        }
    }
</div>
