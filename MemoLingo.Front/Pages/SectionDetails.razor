@page "/section/{SectionId:int}/details"

<PageTitle>Detalhes da Seção</PageTitle>

<div class="detalhes-container">
    <a class="detalhes-voltar" href="/sections">
        <span aria-hidden="true">←</span>
        <span>VOLTAR</span>
    </a>

    @if (loading)
    {
        <p class="carregando"><em>Carregando detalhes da seção...</em></p>
    }
    else if (details == null)
    {
        <p class="lista-vazia">Seção não encontrada.</p>
    }
    else
    {
        <header class="detalhes-cabecalho">
            <span class="detalhes-nivel">NÍVEL @details.CefrLevel</span>
            <h1 class="detalhes-titulo">@details.Title</h1>

            @if (!string.IsNullOrWhiteSpace(details.Description))
            {
                <p class="detalhes-descricao">@details.Description</p>
            }

            <span class="detalhes-status @GetStatusCssClass(details.Status)">@GetStatusLabel(details.Status)</span>
        </header>

        <div class="detalhes-resumo">
            <div class="resumo-item">
                <strong>@details.MasteredWords / @details.TotalWords</strong>
                <span>palavras dominadas (≥ @details.MasteryThreshold%)</span>
            </div>
            <div class="resumo-item">
                <strong>@details.PracticedWords</strong>
                <span>palavras praticadas</span>
            </div>
            <div class="resumo-item">
                <strong>@details.CompletedUnits / @details.TotalUnits</strong>
                <span>unidades concluídas</span>
            </div>
        </div>

        <div class="resumo-barra" role="progressbar" aria-valuenow="@MasteredPercent" aria-valuemin="0" aria-valuemax="100">
            <div class="resumo-barra-preenchida" style="width:@(MasteredPercent)%"></div>
        </div>
        <span class="resumo-barra-legenda">@MasteredPercent% do vocabulário @details.CefrLevel dominado</span>

        @if (!string.IsNullOrWhiteSpace(details.Goal))
        {
            <section class="detalhes-bloco">
                <h2 class="bloco-titulo">Objetivo do nível</h2>
                <p class="bloco-texto">@details.Goal</p>
            </section>
        }

        @if (details.Requirements?.Count > 0)
        {
            <section class="detalhes-bloco">
                <h2 class="bloco-titulo">Requisitos para concluir o nível @details.CefrLevel</h2>
                <ul class="requisitos-lista">
                    @foreach (var requirement in details.Requirements)
                    {
                        <li class="requisito-item">
                            <span class="requisito-icone" aria-hidden="true">✓</span>
                            <span>@requirement</span>
                        </li>
                    }
                </ul>
            </section>
        }

        @if (details.GrammarTopics?.Count > 0)
        {
            <section class="detalhes-bloco">
                <h2 class="bloco-titulo">Gramática do nível</h2>

                <div class="gramatica-lista">
                    @foreach (var topic in details.GrammarTopics)
                    {
                        <article class="gramatica-card @(topic.IsMandatory ? "obrigatorio" : null)" @key="topic.Id">
                            <div class="gramatica-topo">
                                <h3 class="gramatica-titulo">@topic.Title</h3>
                                @if (topic.IsMandatory)
                                {
                                    <span class="gramatica-selo">OBRIGATÓRIO</span>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(topic.Explanation))
                            {
                                <p class="gramatica-explicacao">@topic.Explanation</p>
                            }

                            @if (!string.IsNullOrWhiteSpace(topic.Structure))
                            {
                                <div class="gramatica-estrutura">
                                    @foreach (var line in SplitStructure(topic.Structure))
                                    {
                                        <code>@line</code>
                                    }
                                </div>
                            }

                            @if (topic.Examples?.Count > 0)
                            {
                                <ul class="gramatica-exemplos">
                                    @foreach (var example in topic.Examples)
                                    {
                                        <li>@example</li>
                                    }
                                </ul>
                            }
                        </article>
                    }
                </div>
            </section>
        }

        <section class="detalhes-bloco">
            <h2 class="bloco-titulo">Vocabulário @details.CefrLevel (@details.TotalWords palavras)</h2>

            <div class="palavras-acoes">
                <div class="campo-busca">
                    <span class="campo-busca-icone" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="currentColor">
                            <path d="M10.5 3a7.5 7.5 0 1 1-4.7 13.35l-3.1 3.1a1 1 0 0 1-1.4-1.42l3.1-3.1A7.5 7.5 0 0 1 10.5 3Zm0 2a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11Z" />
                        </svg>
                    </span>
                    <input type="text"
                           class="campo-busca-input"
                           placeholder="Pesquisar palavra ou tradução"
                           aria-label="Pesquisar palavra"
                           value="@searchTerm"
                           @oninput="OnSearchChanged" />
                </div>

                <div class="filtros">
                    @foreach (var filter in Filters)
                    {
                        <button type="button"
                                class="filtro @(filter.Key == selectedFilter ? "ativo" : null)"
                                @onclick="() => selectedFilter = filter.Key">
                            @filter.Value (@CountByFilter(filter.Key))
                        </button>
                    }
                </div>
            </div>

            @if (FilteredWords.Count == 0)
            {
                <p class="lista-vazia">Nenhuma palavra encontrada.</p>
            }
            else
            {
                <div class="lista-palavras">
                    @foreach (var word in FilteredWords)
                    {
                        <div class="palavra-card" @key="word.Id">
                            <div class="palavra-info">
                                <strong class="palavra-texto">@word.Text</strong>
                                <span class="palavra-traducao">@word.Translation</span>
                            </div>

                            <div class="palavra-estatisticas">
                                <span class="badge-acerto" title="Acertos no histórico">
                                    <svg class="badge-icone" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                        <path d="M9.6 16.2 5.4 12l-1.4 1.4 5.6 5.6L20.4 7.8 19 6.4l-9.4 9.8Z" />
                                    </svg>
                                    @word.CorrectCount
                                </span>
                                <span class="badge-erro" title="Erros no histórico">
                                    <svg class="badge-icone" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                        <path d="M18.3 5.7 12 12l6.3 6.3-1.4 1.4L10.6 13.4 4.3 19.7 2.9 18.3 9.2 12 2.9 5.7l1.4-1.4L10.6 10.6l6.3-6.3 1.4 1.4Z" />
                                    </svg>
                                    @word.WrongCount
                                </span>
                            </div>

                            <div class="palavra-aprendizado">
                                <div class="aprendizado-topo">
                                    <span class="aprendizado-percentual">@word.LearningPercentage%</span>
                                    <span class="aprendizado-detalhe">@GetAttemptsSummary(word)</span>
                                </div>
                                <div class="aprendizado-barra" role="progressbar"
                                     aria-valuenow="@word.LearningPercentage" aria-valuemin="0" aria-valuemax="100">
                                    <div class="aprendizado-barra-preenchida @GetProgressCssClass(word.LearningPercentage)"
                                         style="width: @(word.LearningPercentage)%"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    }
</div>
