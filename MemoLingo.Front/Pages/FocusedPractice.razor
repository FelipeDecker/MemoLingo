@page "/pratica/atividade"
@inject IPracticeService PracticeService
@inject NavigationManager Navigation

<PageTitle>Prática Focada</PageTitle>

<div class="pratica-container">
    @if (loading)
    {
        <p class="carregando"><em>Preparando sua prática...</em></p>
    }
    else if (queue.Count == 0)
    {
        <div class="resumo-sessao">
            <h2>Nada para praticar ainda</h2>
            <p>Conclua algumas lições para desbloquear palavras na Prática Focada.</p>
            <button class="btn-iniciar" @onclick="GoBackToHub">Voltar para praticar</button>
        </div>
    }
    else if (sessionCompleted)
    {
        <div class="resumo-sessao">
            <h2>Sessão concluída! 🎉</h2>
            <p>Você acertou @sessionCorrectCount de @queue.Count palavras.</p>

            <div class="resumo-metricas">
                <div class="resumo-metrica">
                    <span class="resumo-metrica-valor">@AccuracyPercentage%</span>
                    <span class="resumo-metrica-rotulo">Acertos</span>
                </div>
                <div class="resumo-metrica">
                    <span class="resumo-metrica-valor">+@EarnedXp XP</span>
                    <span class="resumo-metrica-rotulo">Experiência</span>
                </div>
            </div>

            <button class="btn-iniciar" @onclick="GoBackToHub">Concluir</button>
        </div>
    }
    else
    {
        var currentWord = queue[currentIndex];

        <div class="sessao-progresso">Palavra @(currentIndex + 1) de @queue.Count</div>

        <div class="flashcard">
            <span class="flashcard-texto">@currentWord.Text</span>

            @if (showTranslation)
            {
                <span class="flashcard-traducao">@currentWord.Translation</span>

                <div class="flashcard-acoes">
                    <button class="btn-errei" @onclick="() => AnswerAsync(false)">Errei</button>
                    <button class="btn-acertei" @onclick="() => AnswerAsync(true)">Acertei</button>
                </div>
            }
            else
            {
                <button class="btn-revelar" @onclick="() => showTranslation = true">
                    Mostrar tradução
                </button>
            }
        </div>
    }
</div>

@code {
    // XP concedido por cada palavra respondida corretamente na Prática Focada.
    private const int XpPerCorrectAnswer = 2;

    private List<PracticeWordModel> queue = new();
    private int currentIndex;
    private int sessionCorrectCount;
    private bool showTranslation;
    private bool sessionCompleted;
    private bool loading = true;

    private int AccuracyPercentage => queue.Count == 0
        ? 0
        : (int)Math.Round((double)sessionCorrectCount / queue.Count * 100, MidpointRounding.AwayFromZero);

    private int EarnedXp => sessionCorrectCount * XpPerCorrectAnswer;

    protected override async Task OnInitializedAsync()
    {
        await StartSessionAsync();
    }

    private async Task StartSessionAsync()
    {
        loading = true;

        // A API aplica o algoritmo 6-2-2 sobre as palavras já aprendidas e embaralha o resultado.
        queue = await PracticeService.GetFocusedPracticeWordsAsync();

        currentIndex = 0;
        sessionCorrectCount = 0;
        showTranslation = false;
        sessionCompleted = false;
        loading = false;
    }

    private async Task AnswerAsync(bool correct)
    {
        var currentWord = queue[currentIndex];
        await PracticeService.RegisterResultAsync(currentWord.Id, correct);

        if (correct)
        {
            sessionCorrectCount++;
        }

        if (currentIndex + 1 < queue.Count)
        {
            currentIndex++;
            showTranslation = false;
        }
        else
        {
            sessionCompleted = true;
        }
    }

    private void GoBackToHub()
    {
        Navigation.NavigateTo("/pratica");
    }
}
