@page "/pratica"
@inject IWordService WordService

<PageTitle>Praticar</PageTitle>

<div class="pratica-container">
    <h1>Praticar</h1>
    <p class="pratica-subtitulo">
        Aqui você pratica exatamente as palavras que mais te derrubam — nosso algoritmo prioriza
        sempre o que você mais erra, para você reforçar o que realmente precisa.
    </p>

    @if (words == null)
    {
        <p class="carregando"><em>Carregando suas palavras...</em></p>
    }
    else if (!sessionActive && !sessionCompleted)
    {
        <div class="lista-palavras">
            @foreach (var word in words)
            {
                <div class="palavra-card">
                    <div class="palavra-info">
                        <strong class="palavra-texto">@word.Text</strong>
                        <span class="palavra-traducao">@word.Translation</span>
                    </div>
                    <div class="palavra-estatisticas">
                        <span class="badge-erro" title="Erros">✗ @word.WrongCount</span>
                        <span class="badge-acerto" title="Acertos">✓ @word.CorrectCount</span>
                    </div>
                </div>
            }
        </div>

        <button class="btn-iniciar" @onclick="StartSession" disabled="@(words.Count == 0)">
            Praticar palavras com mais erros
        </button>
    }
    else if (sessionActive)
    {
        var currentWord = queue[currentIndex];

        <div class="sessao-progresso">Palavra @(currentIndex + 1) de @queue.Count</div>

        <div class="flashcard">
            <span class="flashcard-texto">@currentWord.Text</span>

            @if (showTranslation)
            {
                <span class="flashcard-traducao">@currentWord.Translation</span>

                <div class="flashcard-acoes">
                    <button class="btn-errei" @onclick="() => AnswerAsync(false)">Errei</button>
                    <button class="btn-acertei" @onclick="() => AnswerAsync(true)">Acertei</button>
                </div>
            }
            else
            {
                <button class="btn-revelar" @onclick="() => showTranslation = true">
                    Mostrar tradução
                </button>
            }
        </div>
    }
    else if (sessionCompleted)
    {
        <div class="resumo-sessao">
            <h2>Sessão concluída! 🎉</h2>
            <p>Você acertou @sessionCorrectCount de @queue.Count palavras.</p>
            <button class="btn-iniciar" @onclick="RestartAsync">Voltar para a lista</button>
        </div>
    }
</div>

@code {
    private List<Word> words;
    private List<Word> queue = new();
    private int currentIndex;
    private int sessionCorrectCount;
    private bool showTranslation;
    private bool sessionActive;
    private bool sessionCompleted;

    protected override async Task OnInitializedAsync()
    {
        words = await WordService.GetWordsForPracticeAsync();
    }

    private void StartSession()
    {
        if (words == null || words.Count == 0)
        {
            return;
        }

        // Foca a sessão nas palavras com mais erros: pega até as 5 primeiras da lista,
        // que já vem ordenada da maior para a menor quantidade de erros.
        queue = words.Take(5).ToList();
        currentIndex = 0;
        sessionCorrectCount = 0;
        showTranslation = false;
        sessionCompleted = false;
        sessionActive = true;
    }

    private async Task AnswerAsync(bool correct)
    {
        var currentWord = queue[currentIndex];
        await WordService.RegisterResultAsync(currentWord.Id, correct);

        if (correct)
        {
            sessionCorrectCount++;
        }

        if (currentIndex + 1 < queue.Count)
        {
            currentIndex++;
            showTranslation = false;
        }
        else
        {
            sessionActive = false;
            sessionCompleted = true;
        }
    }

    private async Task RestartAsync()
    {
        sessionCompleted = false;
        // Recarrega a lista para refletir os novos números de erros/acertos.
        words = await WordService.GetWordsForPracticeAsync();
    }
}
