  { "languageCode": "en", "cefrLevel": "A1", "text": "My mother and my father live here.", "translation": "Minha mãe e meu pai moram aqui.", "alternativeTranslations": ["A minha mãe e o meu pai moram aqui.", "Minha mãe e meu pai vivem aqui."] },
  { "languageCode": "en", "cefrLevel": "A1", "text": "The boy writes his name.", "translation": "O menino escreve o nome dele.", "alternativeTranslations": ["O menino escreve seu nome.", "O menino escreve o seu nome.", "O garoto escreve o nome dele."] },
  { "languageCode": "en", "cefrLevel": "A1", "text": "The girl reads a book at school.", "translation": "A menina lê um livro na escola.", "alternativeTranslations": ["A garota lê um livro na escola."] },
  { "languageCode": "en", "cefrLevel": "A1", "text": "The woman speaks four languages.", "translation": "A mulher fala quatro idiomas.", "alternativeTranslations": ["A mulher fala quatro línguas."] },

  { "languageCode": "en", "cefrLevel": "A1", "text": "I drink water every day.", "translation": "Eu bebo água todos os dias.", "alternativeTranslations": ["Bebo água todos os dias.", "Eu tomo água todos os dias."] },
  { "languageCode": "en", "cefrLevel": "A1", "text": "She eats bread with cheese.", "translation": "Ela come pão com queijo." },
  { "languageCode": "en", "cefrLevel": "A1", "text": "My father drinks coffee in the morning.", "translation": "Meu pai bebe café de manhã.", "alternativeTranslations": ["O meu pai bebe café de manhã.", "Meu pai toma café de manhã."] },
  { "languageCode": "en", "cefrLevel": "A1", "text": "I want a glass of milk.", "translation": "Eu quero um copo de leite.", "alternativeTranslations": ["Quero um copo de leite."] },
  { "languageCode": "en", "cefrLevel": "A1", "text": "Do you want juice or water?", "translation": "Você quer suco ou água?", "alternativeTranslations": ["Tu queres suco ou água?"] },
  { "languageCode": "en", "cefrLevel": "A1", "text": "The child eats rice and meat.", "translation": "A criança come arroz e carne." },
  { "languageCode": "en", "cefrLevel": "A1", "text": "I eat an egg and an apple.", "translation": "Eu como um ovo e uma maçã.", "alternativeTranslations": ["Como um ovo e uma maçã."] },

  { "languageCode": "en", "cefrLevel": "A1", "text": "We have two dogs.", "translation": "Nós temos dois cachorros.", "alternativeTranslations": ["Temos dois cachorros.", "Nós temos dois cães.", "Temos dois cães."] },
  { "languageCode": "en", "cefrLevel": "A1", "text": "The cat is black and white.", "translation": "O gato é preto e branco." },
  { "languageCode": "en", "cefrLevel": "A1", "text": "The bird is blue.", "translation": "O pássaro é azul." },
  { "languageCode": "en", "cefrLevel": "A1", "text": "The horse eats green grass.", "translation": "O cavalo come grama verde.", "alternativeTranslations": ["O cavalo come capim verde."] },
  { "languageCode": "en", "cefrLevel": "A1", "text": "They have five fish.", "translation": "Eles têm cinco peixes.", "alternativeTranslations": ["Elas têm cinco peixes."] },

  { "languageCode": "en", "cefrLevel": "A1", "text": "The girl has a red apple.", "translation": "A menina tem uma maçã vermelha.", "alternativeTranslations": ["A garota tem uma maçã vermelha."] },
  { "languageCode": "en", "cefrLevel": "A1", "text": "I have one yellow book.", "translation": "Eu tenho um livro amarelo.", "alternativeTranslations": ["Tenho um livro amarelo."] },
  { "languageCode": "en", "cefrLevel": "A1", "text": "We live in a white house.", "translation": "Nós moramos em uma casa branca.", "alternativeTranslations": ["Moramos em uma casa branca.", "Nós moramos numa casa branca.", "Nós vivemos em uma casa branca."] },

  { "languageCode": "en", "cefrLevel": "A1", "text": "They speak English at home.", "translation": "Eles falam inglês em casa.", "alternativeTranslations": ["Elas falam inglês em casa."] },
  { "languageCode": "en", "cefrLevel": "A1", "text": "I go to school every day.", "translation": "Eu vou para a escola todos os dias.", "alternativeTranslations": ["Vou para a escola todos os dias.", "Eu vou à escola todos os dias."] },

  { "languageCode": "en", "cefrLevel": "A2", "text": "Where is the airport?", "translation": "Onde fica o aeroporto?", "alternativeTexts": ["Where's the airport?"], "alternativeTranslations": ["Onde é o aeroporto?", "Onde está o aeroporto?"] },
  { "languageCode": "en", "cefrLevel": "A2", "text": "I need a ticket to London.", "translation": "Eu preciso de uma passagem para Londres.", "alternativeTranslations": ["Preciso de uma passagem para Londres.", "Eu preciso de um bilhete para Londres."] },
  { "languageCode": "en", "cefrLevel": "A2", "text": "My flight arrives at five.", "translation": "Meu voo chega às cinco.", "alternativeTranslations": ["O meu voo chega às cinco."] },
  { "languageCode": "en", "cefrLevel": "A2", "text": "My luggage is in the hotel.", "translation": "Minha bagagem está no hotel.", "alternativeTranslations": ["A minha bagagem está no hotel."] },
  { "languageCode": "en", "cefrLevel": "A2", "text": "Can I have the key of my room?", "translation": "Pode me dar a chave do meu quarto?", "alternativeTranslations": ["Posso pegar a chave do meu quarto?", "Você pode me dar a chave do meu quarto?"] },
  { "languageCode": "en", "cefrLevel": "A2", "text": "The train leaves from this street.", "translation": "O trem sai desta rua.", "alternativeTranslations": ["O trem parte desta rua."] },
  { "languageCode": "en", "cefrLevel": "A2", "text": "Can you show me the map?", "translation": "Você pode me mostrar o mapa?", "alternativeTranslations": ["Pode me mostrar o mapa?"] },
  { "languageCode": "en", "cefrLevel": "A2", "text": "I do not have money today.", "translation": "Eu não tenho dinheiro hoje.", "alternativeTexts": ["I don't have money today."], "alternativeTranslations": ["Não tenho dinheiro hoje."] },
  { "languageCode": "en", "cefrLevel": "A2", "text": "We want to eat in a restaurant.", "translation": "Nós queremos comer em um restaurante.", "alternativeTranslations": ["Queremos comer em um restaurante.", "Nós queremos comer num restaurante."] },
  { "languageCode": "en", "cefrLevel": "A2", "text": "I like to travel with my friend.", "translation": "Eu gosto de viajar com meu amigo.", "alternativeTranslations": ["Gosto de viajar com meu amigo.", "Eu gosto de viajar com minha amiga.", "Eu gosto de viajar com o meu amigo."] }
]
